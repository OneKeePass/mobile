# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

## Both OneKeePassMobile and OneKeePassAutoFill targets share React Native core pods.
## Third-party native modules are linked per concrete target so the AutoFill
## extension can exclude heavy modules it does not use.

AUTOFILL_NATIVE_PACKAGES = [
  '@react-native-community/slider',
  '@react-native-vector-icons/material-design-icons',
  'react-native-gesture-handler',
  'react-native-safe-area-context',
  'react-native-svg',
]


def filter_native_modules(config, allowed_names)
  filtered = config.dup
  filtered[:ios_packages] = config[:ios_packages].select do |package|
    allowed_names.include?(package[:name])
  end
  filtered
end

abstract_target 'OneKeePassMobile-Abstract' do
  config = list_native_modules!($default_command)

  # RN 0.85 enables prebuilt iOS artifacts by default when these env vars are unset:
  # RCT_USE_RN_DEP=1 uses the prebuilt ReactNativeDependencies pod, and
  # RCT_USE_PREBUILT_RNCORE=1 uses the prebuilt React-Core-prebuilt pod.
  #
  # In this app those prebuilt pods caused Debug simulator dev-server issues
  # and missing Debug renderer symbols with some new-architecture native modules.
  # Keep both disabled to preserve the pre-RN-0.85 behavior: build RN core and
  # its iOS dependencies from source pods, with normal Metro/dev support behavior.
  ENV['RCT_USE_RN_DEP'] = '0'
  ENV['RCT_USE_PREBUILT_RNCORE'] = '0'

  use_react_native!(
    :path => config[:react_native_path],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    # :new_arch_enabled => true
  )

  target 'OneKeePassMobile' do
    link_native_modules!(config)
    # pod 'React-jsc', :path => '../node_modules/@react-native-community/javascriptcore'
  end

  target 'OneKeePassAutoFill' do
    link_native_modules!(filter_native_modules(config, AUTOFILL_NATIVE_PACKAGES))
    #pod 'React-jsc', :path => '../node_modules/@react-native-community/javascriptcore'
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:react_native_path],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # This is specific to Pods mobile/ios/Pods/fmt/ compile error. 
    # When we upgrade RN, we may need to remove this if this is resolved in Pods source itself

    # Fix: fmt consteval is broken with Xcode 26.4+ (stricter Apple Clang consteval rules).
    # fmt 11.0.2 enables consteval for Apple Clang >= build version 14000029, but newer
    # Xcode enforces it more strictly, causing format-inl.h to fail. Patch base.h to
    # disable consteval for all Apple Clang builds, falling back to runtime validation.
    fmt_base_h = File.join(installer.sandbox.root, "fmt/include/fmt/base.h")
    if File.exist?(fmt_base_h)
      content = File.read(fmt_base_h)
      patched = content.gsub(
        '#elif defined(__apple_build_version__) && __apple_build_version__ < 14000029L',
        '#elif defined(__apple_build_version__)'
      )
      if patched != content
        FileUtils.chmod(0644, fmt_base_h)
        File.write(fmt_base_h, patched)
        Pod::UI.puts "Patched fmt/base.h: disabled FMT_USE_CONSTEVAL for Apple Clang (Xcode 26.4+ fix)"
      end
    end

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # Allow non app-extension-safe APIs so React Native can compile for the extension
        config.build_settings['APPLICATION_EXTENSION_API_ONLY'] = 'NO'
      end
    end

  end
end

=begin 
target 'OneKeePassMobile' do
  
  config = use_native_modules!
  
  use_react_native!(
    :path => config[:reactNativePath],
    # Hermes is now enabled by default. 
    # It seems from 0.79.x onwards, passing :hermes_enabled no longer does anything.
    # To use JavaScriptCore (JSC) instead of Hermes, we need to use steps as decribed in
    # https://reactnative.dev/docs/0.81/hermes?platform=ios and in https://github.com/react-native-community/javascriptcore
    # When tried this, the pod install for this target went through but for OneKeePassAutoFill target, it failed with some errors. 
    # :hermes_enabled => false,

    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )
  
  post_install do |installer|
    
    react_native_post_install(
      installer,
      # Set `mac_catalyst_enabled` to `true` in order to apply patches
      # necessary for Mac Catalyst builds
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )
    
    # Added after introducing autofill extension
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['APPLICATION_EXTENSION_API_ONLY'] = 'NO'
      end
    end
    
  end
end


target 'OneKeePassAutoFill' do
  
  ## Some references:
  # https://github.com/react-native-community/cli/issues/1179#issuecomment-756539463
  # https://github.com/codibly/app-clip-instant-app-react-native/blob/main/Handling-Size-React-Native-AppClip.md
  # https://gist.github.com/ridvanaltun/a02a9a8a8d4bbd354a5cd875a20cf21f
  
  # https://github.com/react-native-community/cli/blob/v15.0.1/docs/autolinking.md#platform-ios
  # react-native-community/cli v15.0.1 is used with RN 0.78.2
  
  ## ** This worked till RN 0.74.5 and did not work with RN 0.78.2 upgrade **
  
  # Requires a patching in
  # /node_modules/@react-native-community/cli-platform-ios/native_modules.rb
  # to use 'packages_to_skip'
  # config = use_native_modules!(packages_to_skip:['RNBootSplash', 'RNCClipboard','RNReanimated','RNFileViewer', 'VisionCamera','RNVectorIcons'])
  
  
  ## ** After RN 0.78.2 upgrade, we need make changes in /node_modules/react-native/scripts/cocoapods/autolinking.rb **
    
  # Require a patching of /node_modules/react-native/scripts/cocoapods/autolinking.rb where we skip some native module packages
  # The following ENV varable OKP_AUTOFILL_TARGET is used to identify the autofill target so that skipping of the pods
  # are considered for this target only

  # While upgrading to RN 9.81.5, noticed that even without this patch, the OneKeePassAutoFill target works fine.
  # But keeping this as is for now. Need to check whether excluding few packages will reduce the size of the extension.

  ENV['OKP_AUTOFILL_TARGET'] = "true"
  
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # See the comment above regarding Hermes
    # :hermes_enabled => false,
    
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )
  
end
=end
