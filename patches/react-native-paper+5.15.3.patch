+const DefaultRenderer = (props: RenderProps) => (
+  // OKP: disable font scaling only in the iOS autofill extension bundle
+  // (facebook/react-native#54642 — RCTFontSizeMultiplier returns 0 in an .appex,
+  // shrinking the input text to ~0). Gated by a global flag set in
+  // index.ios.autofill.extension.js; before {...props} so explicit props win.
+  // This is the default renderer TextInput passes to TextInputFlat/Outlined.
+  <NativeTextInput
+    allowFontScaling={
+      (globalThis as any).__OKP_NO_FONT_SCALING__ ? false : undefined
+    }
+    {...props}
+  />
+);
 
